{
  "schema_version": 2,
  "id": "weather_plugin",
  "name": "天气与 IP 查询",
  "version": "2.0.0",
  "description": "高德实况、每日预报、城市编码和国内 IPv4 定位，支持明确天气指令免 @。",
  "config": {
    "amap_key": "",
    "default_city": ""
  },
  "permissions": [
    "message:read",
    "message:send",
    "network:amap"
  ],
  "config_schema": [
    {
      "key": "amap_key",
      "label": "高德 Web 服务 Key",
      "type": "secret",
      "default": ""
    },
    {
      "key": "default_city",
      "label": "默认城市",
      "type": "string",
      "default": ""
    }
  ],
  "author": "QQ 机器人管理器",
  "runtime": "builtin",
  "entrypoint": "lib/weather_plugin/plugin.dart"
}

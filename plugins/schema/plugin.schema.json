{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qqm:plugin:v2",
  "title": "QQ 机器人管理器可导入插件协议 v2（兼容 v1）",
  "description": "规则、HTTP 和跨平台 Hetu 脚本插件。宿主还会进行权限、URL、配置与源码大小交叉校验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "runtime",
    "permissions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 512
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "author": {
      "type": "string",
      "maxLength": 120
    },
    "runtime": {
      "enum": [
        "rules",
        "http",
        "script"
      ]
    },
    "listen_all": {
      "type": "boolean",
      "default": false
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 100
    },
    "cooldown_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000,
      "default": 0
    },
    "media_hosts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 253
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "message:read",
          "message:send",
          "network:http",
          "message:media",
          "interaction:read",
          "events:group-all",
          "storage:local"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "message:read"
          }
        },
        {
          "contains": {
            "const": "message:send"
          }
        }
      ]
    },
    "config_schema": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "enum": [
              "string",
              "multiline",
              "secret",
              "boolean",
              "integer"
            ]
          },
          "default": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          },
          "required": {
            "type": "boolean",
            "default": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "string",
                    "multiline",
                    "secret"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "string",
                  "maxLength": 8192
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "boolean"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "integer"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "integer"
                }
              }
            }
          }
        ]
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean"
        ]
      }
    },
    "rules": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "match"
        ],
        "properties": {
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "command",
                  "exact",
                  "prefix",
                  "contains",
                  "callback"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              },
              "scope": {
                "enum": [
                  "all",
                  "group",
                  "private"
                ],
                "default": "all"
              },
              "case_sensitive": {
                "type": "boolean",
                "default": false
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "command"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "pattern": "^[^\\s/#]+$"
                    }
                  }
                }
              }
            ]
          },
          "reply": {
            "type": "string",
            "maxLength": 16000
          },
          "permission": {
            "enum": [
              "all",
              "admin",
              "owner"
            ]
          },
          "message": {
            "$ref": "#/$defs/message"
          }
        },
        "not": {
          "required": [
            "reply",
            "message"
          ]
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^(https://|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?/)"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 20000,
          "default": 8000
        },
        "token_config": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
        },
        "send_config_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,60}\\.ht$"
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language"
      ],
      "properties": {
        "language": {
          "const": "hetu"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "hosts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9.-]{1,252}$"
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 40000,
          "default": 3000
        },
        "commands": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[^\\s/#]{1,60}$"
              },
              "description": {
                "type": "string",
                "maxLength": 200
              },
              "usage": {
                "type": "string",
                "maxLength": 200
              },
              "aliases": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "pattern": "^[^\\s/#]{1,60}$"
                }
              }
            }
          }
        },
        "unmentioned": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commands": {
              "type": "boolean",
              "default": true
            },
            "prefixes": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "rules"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "http"
          ]
        },
        "properties": {
          "permissions": {
            "not": {
              "contains": {
                "const": "network:http"
              }
            }
          },
          "rules": {
            "items": {
              "oneOf": [
                {
                  "required": [
                    "reply"
                  ]
                },
                {
                  "required": [
                    "message"
                  ]
                }
              ],
              "properties": {
                "reply": {
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "http"
          }
        }
      },
      "then": {
        "required": [
          "http"
        ],
        "properties": {
          "permissions": {
            "contains": {
              "const": "network:http"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "script"
          }
        }
      },
      "then": {
        "required": [
          "script"
        ],
        "anyOf": [
          {
            "required": [
              "entrypoint"
            ]
          },
          {
            "properties": {
              "script": {
                "required": [
                  "source"
                ]
              }
            }
          }
        ],
        "not": {
          "required": [
            "http"
          ]
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "script"
              ]
            },
            {
              "required": [
                "entrypoint"
              ]
            }
          ]
        },
        "properties": {
          "rules": {
            "minItems": 1
          },
          "permissions": {
            "not": {
              "contains": {
                "const": "storage:local"
              }
            }
          }
        },
        "required": [
          "rules"
        ]
      }
    }
  ],
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "text",
            "markdown",
            "media"
          ],
          "default": "text"
        },
        "content": {
          "type": "string",
          "maxLength": 16000
        },
        "media_url": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^https://"
        },
        "media_type": {
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "buttons": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "data"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10
                },
                "data": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "callback": {
                  "type": "boolean",
                  "default": false
                },
                "url": {
                  "type": "boolean",
                  "default": false
                },
                "user_ids": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,128}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

{
  "schema_version": 2,
  "id": "translate_comment",
  "name": "代码注释翻译",
  "version": "3.0.0",
  "description": "显式命令翻译文本或代码注释；只替换识别到的注释片段，限制大小和超时，不自动上传普通代码块。",
  "config": {
    "api_key": "",
    "target_lang": "中文"
  },
  "permissions": [
    "message:read",
    "message:send",
    "network:http"
  ],
  "config_schema": [
    {
      "key": "model",
      "label": "DeepSeek 模型名称",
      "type": "string",
      "default": "deepseek-flash"
    },
    {
      "key": "api_key",
      "label": "DeepSeek API Key",
      "type": "secret",
      "default": ""
    },
    {
      "key": "target_lang",
      "label": "目标语言",
      "type": "string",
      "default": "中文"
    }
  ],
  "author": "QQ 机器人管理器",
  "runtime": "script",
  "entrypoint": "main.ht",
  "script": {
    "language": "hetu",
    "commands": [
      {
        "name": "注释翻译",
        "description": "只替换注释，保留代码",
        "usage": "注释翻译 ```语言 换行代码```",
        "aliases": [
          "translate",
          "fanyi"
        ]
      },
      {
        "name": "翻译",
        "description": "普通文本翻译",
        "usage": "翻译 文本",
        "aliases": []
      }
    ],
    "hosts": [
      "api.deepseek.com"
    ],
    "timeout_ms": 40000
  }
}

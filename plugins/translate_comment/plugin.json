{
  "schema_version": 2,
  "id": "translate_comment",
  "name": "代码注释翻译",
  "version": "2.0.0",
  "description": "显式命令翻译文本或代码注释；只替换识别到的注释片段，限制大小和超时，不自动上传普通代码块。",
  "config": {
    "api_key": "",
    "target_lang": "中文"
  },
  "permissions": [
    "message:read",
    "message:send",
    "network:deepseek"
  ],
  "config_schema": [
    {"key": "model", "label": "DeepSeek 模型名称", "type": "string", "default": "deepseek-flash"},
    {
      "key": "api_key",
      "label": "DeepSeek API Key",
      "type": "secret",
      "default": ""
    },
    {
      "key": "target_lang",
      "label": "目标语言",
      "type": "string",
      "default": "中文"
    }
  ],
  "author": "QQ 机器人管理器",
  "runtime": "builtin",
  "entrypoint": "lib/translate_comment/plugin.dart"
}

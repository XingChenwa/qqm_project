[Unit]
Description=QQ Bot Manager Web Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qqbotmanager
Group=qqbotmanager
WorkingDirectory=/opt/qqbotmanager
ExecStart=/opt/qqbotmanager/qqm-server --host 127.0.0.1 --port 23336 --data /var/lib/qqbotmanager --assets /opt/qqbotmanager
StateDirectory=qqbotmanager
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/qqbotmanager
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target

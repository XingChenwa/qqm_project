[Unit]
Description=QQ Bot Manager Web Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qqbotmanager
Group=qqbotmanager
WorkingDirectory=/opt/qqbotmanager
Environment=QQM_HOST=127.0.0.1
Environment=QQM_PORT=23336
Environment=QQM_DATA=/var/lib/qqbotmanager
EnvironmentFile=-/etc/qqbotmanager.env
ExecStart=/opt/qqbotmanager/start.sh
StateDirectory=qqbotmanager
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/qqbotmanager
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
